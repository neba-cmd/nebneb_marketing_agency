---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">
        Tell us about your business and what you want to improve online.
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-8 md:gap-10 mx-auto max-w-4xl mt-12 md:mt-16 px-4 md:px-0">
      <div>
        <div class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">
          Start here
        </div>
        <h2 class="font-medium text-xl md:text-2xl text-gray-800 leading-tight mt-3">
          Let&apos;s build your online presence
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-slate-500 mt-3">
          Tell us what you need most right now — content, visibility, or a better website.
        </p>
        <div class="mt-5 space-y-3">
          <div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:map-marker" />
            <span>Support for local businesses, in person or remotely</span>
          </div><div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:envelope" />
            <span>Simple next steps, no pressure</span>
          </div><div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:comment-message" />
            <span>Friendly advice for your next move</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
