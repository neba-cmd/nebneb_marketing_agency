---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">
        Tell us about your business and what you want to improve online.
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-8 md:gap-10 mx-auto max-w-4xl mt-12 md:mt-16 px-4 md:px-0">
      <div>
        <h2 class="font-medium text-xl md:text-2xl text-gray-800 leading-tight">
          Let&apos;s build your online presence
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-slate-500 mt-3">
          Whether you need regular content, a better website, stronger local
          search visibility, or a clearer marketing plan, we would be happy to
          hear where your business is now and where you want it to go.
        </p>
        <div class="mt-5 space-y-3">
          <div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:map-marker" />
            <span>Supporting local businesses in person and remotely</span>
          </div><div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:envelope" />
            <span>Use the form to start a conversation</span>
          </div><div class="flex items-start gap-3 text-gray-600 text-sm md:text-base">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5 flex-shrink-0" name="uil:comment-message" />
            <span>Friendly, practical advice for your next step</span>
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
