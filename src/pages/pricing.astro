---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Content Creation",
    price: "Video, photo, and storytelling",
    popular: false,
    features: [
      "Social media video production",
      "Professional videography and photography",
      "Short-form videos for Reels, TikTok, YouTube Shorts, and Facebook",
      "Brand story, behind-the-scenes, product, service, and lifestyle content",
      "Social-media-ready content formats",
      "Monthly content planning",
    ],
    button: {
      text: "Start a content plan",
      link: "/contact",
    },
  },
  {
    name: "Online Presence",
    price: "Websites, SEO, and reviews",
    popular: true,
    features: [
      "Website design for small businesses",
      "SEO management and recommendations",
      "Google Business Profile management",
      "Google Reviews management",
      "Clear brand positioning and local visibility support",
      "Monthly performance review and recommendations",
    ],
    button: {
      text: "Improve visibility",
      link: "/contact",
    },
  },
  {
    name: "Managed Marketing",
    price: "Ongoing digital support",
    popular: false,
    features: [
      "Social media account management",
      "Caption writing and hashtag strategy",
      "Content scheduling and publishing",
      "Community engagement",
      "Seasonal campaign planning",
      "Local business marketing strategy",
      "Review and recommendation sessions",
    ],
    button: {
      text: "Plan ongoing support",
      link: "/contact",
    },
  },
];
---

<Layout title="Services">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Services</Fragment>
      <Fragment slot="desc">
        Flexible marketing support for small businesses and local brands.
      </Fragment>
    </Sectionhead>

    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10 mx-auto max-w-(--breakpoint-lg) mt-12 md:mt-12 px-4 md:px-0">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
