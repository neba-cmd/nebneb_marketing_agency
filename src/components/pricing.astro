---
import { Tick } from "@/components/ui/icons";
import Link from "@/components/ui/link.astro";

const { plan } = Astro.props;
---

<div>
  <div
    class="flex flex-col w-full order-first lg:order-none border-2 border-[#D8DEE9] border-opacity-50 py-5 px-4 sm:px-6 rounded-md">
    <div class="text-center">
      <h4 class="text-base sm:text-lg font-medium text-gray-400">{plan.name}</h4><p
        class="mt-3 text-2xl sm:text-3xl md:text-4xl font-bold text-black">
        {
          plan.price && typeof plan.price === "object"
            ? plan.price.monthly
            : plan.price
        }
      </p>
    </div><ul class="grid mt-8 text-left gap-y-3 md:gap-y-4">
      {
        plan.features.map((item) => (
          <li class="flex items-start gap-3 text-gray-800 text-sm md:text-base">
            <Tick class="w-5 h-5 md:w-6 md:h-6 flex-shrink-0 mt-0.5" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul><div class="flex mt-6 md:mt-8">
      <Link
        href={plan.button.link || "#"}
        block
        style={plan.popular ? "primary" : "outline"}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</div>
