---
import Link from "./ui/link.astro";
---

<div
  class="bg-gradient-to-r from-slate-900 via-slate-800 to-black p-6 sm:p-8 md:px-20 md:py-20 mt-16 md:mt-20 mx-4 md:mx-auto max-w-5xl rounded-2xl flex flex-col items-center text-center shadow-xl">
  <h2 class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-6xl tracking-tight leading-tight font-semibold">
    Ready to make your business easier to find and trust?
  </h2>
  <p class="text-slate-300 mt-4 text-sm sm:text-base md:text-lg lg:text-xl leading-relaxed max-w-3xl">
    A clear plan, strong content, and a simple next step — all in one place.
  </p>
  <div class="flex mt-6 md:mt-8 w-full sm:w-auto">
    <Link href="/contact" style="inverted" class="w-full sm:w-auto justify-center font-semibold">Start with a conversation</Link>
  </div>
</div>
