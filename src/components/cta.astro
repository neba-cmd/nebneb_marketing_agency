---
import Link from "./ui/link.astro";
---

<div
  class="bg-black p-6 sm:p-8 md:px-20 md:py-20 mt-16 md:mt-20 mx-4 md:mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-6xl tracking-tight leading-tight">
    Ready to make your business easier to find and trust?
  </h2>
  <p class="text-slate-400 mt-4 text-sm sm:text-base md:text-lg lg:text-xl leading-relaxed">
    Let&apos;s build a practical content and digital marketing plan that fits
    your goals, your budget, and the way your business actually works.
  </p>
  <div class="flex mt-6 md:mt-8 w-full sm:w-auto">
    <Link href="/contact" style="inverted" class="w-full sm:w-auto justify-center">Let&apos;s build your online presence</Link>
  </div>
</div>
