---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">
    Content and visibility across the platforms your customers already use
  </h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <Icon class="size-8 md:size-12" name="simple-icons:instagram" />
    <Icon class="size-8 md:size-12" name="simple-icons:tiktok" />
    <Icon class="size-8 md:size-12" name="simple-icons:youtube" />
    <Icon class="size-8 md:size-16" name="simple-icons:facebook" />
    <Icon class="size-8 md:size-16" name="simple-icons:google" />
    <Icon class="size-8 md:size-12" name="simple-icons:wordpress" />

  </div>
</div>
