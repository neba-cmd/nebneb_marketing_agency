---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-12 md:mt-16 px-4 md:px-0", align === "center" && "text-center"]}>
  <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold lg:tracking-tight leading-tight">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-sm sm:text-base md:text-lg mt-4 text-slate-600 leading-relaxed">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
