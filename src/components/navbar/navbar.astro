---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Services",
    path: "/pricing",
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Portfolio",
    path: "/portfolio",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center py-4 md:py-5 px-2 md:px-0">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between gap-4">
        <a href="/" class="text-lg md:text-xl min-h-11 inline-flex items-center"
          ><span class="font-bold text-slate-800">neb</span><span
            class="text-slate-500">neb</span
          >
        </a>
        <div class="block lg:hidden min-h-11 flex items-center">
          <MenuIcon class="w-5 h-5 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 md:py-3 items-center text-gray-600 hover:text-gray-900 text-sm md:text-base min-h-11 px-2 lg:px-3">
                      <span>{item.title}</span>
                      {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] animate-pulse font-semibold uppercase text-white bg-indigo-600 rounded-full">
                          New
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="/pricing" style="muted" block size="md">Services</Link>
          <Link href="/portfolio" style="muted" block size="md">Portfolio</Link>
          <Link href="/contact" size="md" block>Contact</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="/portfolio">Portfolio</a>
        <Link href="/contact" size="md">Let&apos;s talk</Link>
      </div>
    </div>
  </header>
</Container>
