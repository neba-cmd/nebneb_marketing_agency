---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Short-form video content",
    description:
      "Professional filming and edited videos for Instagram Reels, TikTok, YouTube Shorts, and Facebook.",
    icon: "bx:bxs-video-recording",
  },
  {
    title: "Photography and videography",
    description:
      "Lifestyle, branding, product, food, drink, service, team, and atmosphere content for your business.",
    icon: "bx:bxs-camera",
  },
  {
    title: "Website design",
    description:
      "Clear, modern websites that explain what you do, build trust, and help customers take the next step.",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "SEO and local visibility",
    description:
      "Practical SEO management, Google Business Profile updates, and review support so customers can find you.",
    icon: "bx:bxs-file-find",
  },
  {
    title: "Social media management",
    description:
      "Captions, hashtags, content scheduling, publishing, account care, and community engagement.",
    icon: "bx:bxs-calendar",
  },
  {
    title: "Strategy and planning",
    description:
      "Monthly content plans, seasonal campaigns, brand storytelling, and performance reviews with clear next steps.",
    icon: "bx:bxs-bulb",
  },
];
---

<div class="mt-8 md:mt-0 px-4 md:px-0">
  <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold lg:tracking-tight leading-tight">
    Simple support for the parts of marketing that matter most
  </h2>
  <p class="text-base sm:text-lg mt-4 text-slate-600 leading-relaxed">
    We make it easier to show up online with content that feels polished, useful, and worth sharing.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-10 md:mt-14 gap-6 md:gap-8 px-4 md:px-0">
  {
    features.map((item) => (
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition">
        <div class="flex gap-3 md:gap-4 items-start">
          <div class="mt-0.5 bg-black rounded-full p-2 w-8 h-8 shrink-0 flex items-center justify-center">
            <Icon class="text-white w-5 h-5" name={item.icon} />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-base md:text-lg text-slate-900">{item.title}</h3>
            <p class="text-slate-500 text-sm md:text-base mt-2 leading-relaxed">{item.description}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>
