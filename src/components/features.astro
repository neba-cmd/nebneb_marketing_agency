---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Short-form video content",
    description:
      "Professional filming and edited videos for Instagram Reels, TikTok, YouTube Shorts, and Facebook.",
    icon: "bx:bxs-video-recording",
  },
  {
    title: "Photography and videography",
    description:
      "Lifestyle, branding, product, food, drink, service, team, and atmosphere content for your business.",
    icon: "bx:bxs-camera",
  },
  {
    title: "Website design",
    description:
      "Clear, modern websites that explain what you do, build trust, and help customers take the next step.",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "SEO and local visibility",
    description:
      "Practical SEO management, Google Business Profile updates, and review support so customers can find you.",
    icon: "bx:bxs-file-find",
  },
  {
    title: "Social media management",
    description:
      "Captions, hashtags, content scheduling, publishing, account care, and community engagement.",
    icon: "bx:bxs-calendar",
  },
  {
    title: "Strategy and planning",
    description:
      "Monthly content plans, seasonal campaigns, brand storytelling, and performance reviews with clear next steps.",
    icon: "bx:bxs-bulb",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Practical marketing support for local businesses
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    We combine creative content, modern technology, and real management
    experience to help small businesses grow without making digital marketing
    feel confusing or expensive.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
