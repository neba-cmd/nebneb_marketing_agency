---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-8 pb-4 md:pt-12 md:pb-24 px-4 md:px-0">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Creative digital marketing workspace"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <div class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-700 shadow-sm">
      Digital marketing support for local businesses
    </div>
    <h1
      class="mt-4 text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter leading-tight">
      We help your business look <span class="text-slate-700">clearer</span>, <span class="text-slate-700">stronger</span>, and easier to choose.
    </h1>
    <p class="text-base sm:text-lg mt-4 text-slate-600 max-w-xl leading-relaxed">
      Content, websites, SEO, reviews, and strategy — all made simple.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:gap-3">
      <Link
        href="/contact"
        class="flex gap-2 items-center justify-center text-sm sm:text-base shadow-sm"
        rel="noopener">
        <Icon class="text-white w-5 h-5 flex-shrink-0" name="bx:bxs-message-square-dots" />
        <span>Book a free chat</span>
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="/pricing"
        class="flex gap-2 items-center justify-center text-sm sm:text-base"
        >
        <Icon class="text-black w-4 h-4 flex-shrink-0" name="bx:bxs-briefcase" />
        <span>See services</span>
      </Link>
    </div>
  </div>
</main>
